# Text files are stored with LF and checked out with LF on every OS
* text=auto eol=lf
# Windows batch files need CRLF to run
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.gif binary
*.ico binary
*.xlsx binary
# real exports for the import tests keep their bytes: line ends (CRLF), encodings (UTF-16, Windows-1252)
packages/pivotkit-core/test/import-fixtures/*.csv -text
packages/pivotkit-core/test/import-fixtures/*.txt -text
packages/pivotkit-core/test/import-fixtures/*.json -text
# golden files of pivotkit-report keep their bytes: a CSV ends its lines with CRLF
packages/pivotkit-report/test/golden/* -text
