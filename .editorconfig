root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# written by scripts/growth.js with 4 spaces: a ratchet's diff stays the lines that changed
[scripts/growth-baseline.json]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
