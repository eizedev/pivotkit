{
  // Type check of the sources (JSDoc in .js and .jsx, and src/'s own .d.ts): npm run types. The
  // shipped styles.css.d.ts is checked by test/types, which imports the stylesheet. Needs the core's
  // generated types (npm run types in pivotkit-core runs first at the root). The output (types/) is
  // not committed. strict, except noImplicitAny: the JSX components' props are typed where they cross
  // module boundaries, not on every inner callback.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": "src",
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.d.ts"]
}
