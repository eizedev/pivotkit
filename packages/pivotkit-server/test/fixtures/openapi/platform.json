{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform API",
    "version": "2.4.0",
    "description": "Virtual machines, regions and usage of the hosting platform."
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "platformOAuth": [
        "vms:read"
      ]
    }
  ],
  "paths": {
    "/customers/{customerId}/vms": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CustomerId"
        }
      ],
      "get": {
        "operationId": "listVms",
        "summary": "Virtual machines of a customer",
        "description": "Every virtual machine the customer runs, with its size and state.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "description": "Only machines in this state",
            "schema": {
              "type": "string",
              "enum": [
                "running",
                "stopped",
                "deleted"
              ]
            }
          },
          {
            "name": "created-after",
            "in": "query",
            "description": "Only machines created on or after this day",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-01-01"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Machines per page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of machines",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VmPage"
                }
              }
            }
          },
          "404": {
            "description": "No such customer"
          }
        }
      }
    },
    "/regions": {
      "get": {
        "operationId": "listRegions",
        "summary": "Regions",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "All regions",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Region"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/usage.csv": {
      "get": {
        "operationId": "usageCsv",
        "summary": "Usage per day",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": true,
            "description": "The month, as YYYY-MM",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "example": "2026-10"
          }
        ],
        "responses": {
          "200": {
            "description": "CSV",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchVms",
        "summary": "Search machines",
        "security": [],
        "parameters": [
          {
            "name": "filter[name]",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1000
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "api_key",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Vm"
                      }
                    },
                    "facets": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vms": {
      "post": {
        "operationId": "createVm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Vm"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/vms/{id}": {
      "delete": {
        "operationId": "deleteVm",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/archive/{year}-{month}": {
      "get": {
        "operationId": "archiveMonth",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customerId}/vms/{vmId}/disks": {
      "get": {
        "operationId": "listDisks",
        "summary": "Disks of a machine",
        "security": [
          {
            "platformOAuth": [],
            "apiKey": []
          },
          {
            "basic": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CustomerId"
          },
          {
            "name": "vmId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "2XX": {
            "description": "Disks",
            "content": {
              "application/vnd.platform+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "disks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sizeGb": {
                            "type": "integer",
                            "description": "Size in GiB"
                          },
                          "kind": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CustomerId": {
        "name": "customerId",
        "in": "path",
        "required": true,
        "description": "The customer's short name",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "maxLength": 40
        },
        "example": "acme"
      }
    },
    "schemas": {
      "VmPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vm"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "Address of the next page"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Vm": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Resource"
          },
          {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "integer",
                "description": "Virtual CPUs"
              },
              "memoryMb": {
                "type": "integer",
                "description": "Memory in MiB"
              },
              "state": {
                "type": "string",
                "enum": [
                  "running",
                  "stopped"
                ],
                "description": "Whether the machine runs"
              },
              "owner": {
                "type": "string",
                "description": "E-mail address of the person who owns the machine"
              }
            }
          }
        ]
      },
      "Resource": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The machine's name"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When it was created"
          }
        }
      },
      "Region": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Region code, such as eu-central"
          },
          "city": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "platformOAuth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.com/oauth/token",
            "scopes": {
              "vms:read": "Read machines"
            }
          }
        }
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "basic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}