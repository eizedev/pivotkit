{
  "name": "pivotkit-element",
  "version": "0.1.0",
  "description": "The pivot report builder of pivotkit as the web component <pivot-report>, with its own React: for Angular, PHP and plain HTML pages without React.",
  "license": "MIT",
  "author": "eizedev <oss@eize.dev>",
  "homepage": "https://pivotkit.eize.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eizedev/pivotkit.git",
    "directory": "packages/pivotkit-element"
  },
  "bugs": "https://github.com/eizedev/pivotkit/issues",
  "keywords": [
    "pivot-table",
    "pivot",
    "web-component",
    "custom-element",
    "reporting",
    "echarts",
    "self-service-bi"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "default": "./dist/element.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types/index.d.ts",
    "types/element.d.ts",
    "types/events.d.ts",
    "types/global.d.ts",
    "types/jsx.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.js",
    "size": "node build.js --size",
    "test": "node build.js && node --test \"test/*.test.js\"",
    "types": "tsc -p . && node types.js",
    "test:types": "tsc -p test/types",
    "prepack": "node build.js && npm run types && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "coverage": "node build.js && node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" \"test/*.test.js\""
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "echarts": "6.1.0",
    "pivotkit-core": "0.1.0",
    "pivotkit-react": "0.1.0",
    "react": "19.3.1",
    "react-dom": "18.3.1"
  },
  "types": "./types/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
