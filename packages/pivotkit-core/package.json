{
  "name": "pivotkit-core",
  "version": "0.0.0",
  "description": "Pivot engine without UI: typed encoding, pivot tables with totals and subtotals, show values as, filters, date grouping, chart options for Apache ECharts, XLSX and CSV export.",
  "license": "MIT",
  "author": "eizedev <oss@eize.dev>",
  "homepage": "https://pivotkit.eize.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eizedev/pivotkit.git",
    "directory": "packages/pivotkit-core"
  },
  "bugs": "https://github.com/eizedev/pivotkit/issues",
  "keywords": [
    "pivot-table",
    "pivot",
    "reporting",
    "excel-export",
    "echarts",
    "self-service-bi"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./export": {
      "types": "./types/export.d.ts",
      "default": "./src/export.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:types": "tsc -p test/types",
    "types": "tsc -p .",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/*.test.js\"",
    "bench": "node bench/bench.js",
    "prepack": "npm run types && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "fast-xml-parser": "5.11.2",
    "read-excel-file": "9.3.12"
  },
  "types": "./types/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
